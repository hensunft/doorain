# DoorAIn: шаблон конфигурации. Секреты здесь НЕ хранятся. Создайте .env командой:
#   scripts/doorain.ps1 init   (Windows)   |   scripts/doorain.sh init   (Linux)
# Команда сгенерирует случайные значения и не перезапишет существующий .env. .env не попадает в Git.

# --- обязательные секреты (генерируются `init`) ---
POSTGRES_PASSWORD=
DOORAIN_SECRET_KEY=

# --- локальный доступ ---
DOORAIN_HTTP_PORT=8080

# --- интернет-режим (compose.internet.yaml): реальный домен, принадлежащий вам ---
DOORAIN_DOMAIN=

# --- модели (после изменения перезапустите worker; смена embeddings требует новой generation) ---
# GigaChat 3.1 Lightning (infra/models.lock.json, раздел gguf) — на ноутбуке с 6 ГБ видеопамяти запускайте с -Gpu.
# Запасной вариант без GPU: qwen3:4b-instruct-2507-q4_K_M, NUM_CTX=4096, TEMPLATE_TOKENS=120 (затем prepare).
DOORAIN_OLLAMA_MODEL=gigachat3.1:10b-a1.8b-q4_K_M
DOORAIN_OLLAMA_NUM_CTX=8192
DOORAIN_OLLAMA_TEMPLATE_TOKENS=1200
# Порог отказа: откалибруйте на проверочной выборке (docs/evaluation.md); 0.0 = не откалиброван
DOORAIN_MIN_RERANK_SCORE=0.0
DOORAIN_THRESHOLD_SOURCE=uncalibrated

# --- сборка: 1 = с локальными моделями (CPU torch), 0 = облегчённый образ для проверок без моделей ---
WITH_ML=1
DOORAIN_VERSION=0.1.0
COMPOSE_PROJECT_NAME=doorain
